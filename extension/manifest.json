{
  "manifest_version": 3,
  "name": "Samsudin Credentials Exporter",
  "version": "1.0.0",
  "description": "Ekstrak session token & cookies dari DeepSeek, MiniMax, Kimi, Wenxin, Hunyuan, Qwen, GLM, InternLM, dan Xiaomi untuk Samsudin Agent Harness.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Samsudin Credentials Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.deepseek.com/*",
    "*://*.moonshot.cn/*",
    "*://*.minimax.io/*",
    "*://*.xiaomimimo.com/*",
    "*://*.z.ai/*",
    "*://*.qwen.ai/*",
    "*://*.intern-ai.org.cn/*",
    "*://*.tencent.ai/*",
    "*://*.baidu.com/*"
  ]
}
